# Primekey Homes - Environment Variables Template
# Copy this file to .env and fill in your values

# Django Core
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL only - required)
DATABASE_URL=postgresql://primekey:your_password_here@127.0.0.1:5432/primekey

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
DJANGO_Q_REDIS_URL=redis://localhost:6379/2

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# OTP Providers
# Resend for email OTP, Sendchamp for SMS OTP
# Get Resend key at https://resend.com/api-keys
# Get Sendchamp key at https://sendchamp.com/dashboard/api
RESEND_API_KEY=
SENDCHAMP_API_KEY=
SENDCHAMP_SENDER_ID=Primekey
SENDCHAMP_ROUTE=dnd

# Executive admin accounts (used by: python manage.py setup_roles)
# Leave unset to fall back to temporary ChangeMe-* passwords (change after first login).
ADMIN_PASSWORD=
CEO_PASSWORD=
CTO_PASSWORD=
COO_PASSWORD=