# Primekey Homes - Environment Variables Template
# Copy this file to .env and fill in your values

# Django Core
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# SQLite (development)
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/primekey

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
DJANGO_Q_REDIS_URL=redis://localhost:6379/2

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True

# SMS Provider (OTP delivery)
# Set to "termii" to enable real SMS, leave empty for console logging
SMS_PROVIDER=
TERMII_API_KEY=
TERMII_SENDER_ID=PrimeKey
TERMII_CHANNEL=dnd

# Sentry (error tracking)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# S3 File Storage (leave AWS_STORAGE_BUCKET_NAME empty for local filesystem)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=
AWS_DEFAULT_ACL=private

# Logging
LOG_LEVEL=

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Executive admin accounts (used by: python manage.py setup_roles)
# Leave unset to fall back to temporary ChangeMe-* passwords (change after first login).
CEO_PASSWORD=
CTO_PASSWORD=
COO_PASSWORD=