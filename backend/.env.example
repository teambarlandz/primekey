# Primekey Homes - Environment Variables Template
# Copy this file to .env and fill in your values

# Django Core
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
# Optional. Defaults to DEBUG in development and INFO in production. Without a
# LOGGING config Django drops everything below WARNING, which hides logger.info
# calls such as the OTP delivery audit trail.
# LOG_LEVEL=INFO

# Database (PostgreSQL only - required)
DATABASE_URL=postgresql://primekey:your_password_here@127.0.0.1:5432/primekey

# Redis Configuration
# NOTE: the three logical databases below matter. Render's Key Value
# connectionString is redis://host:6379 with no db index, so on Render these
# three values resolve to the same database unless the index is appended in
# settings.py. See PRODUCTION_READY.md 7.3 (H1).
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
DJANGO_Q_REDIS_URL=redis://localhost:6379/2

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True
# Only needed to override the default: settings.py already sets
# CSRF_TRUSTED_ORIGINS from CORS_ALLOWED_ORIGINS so there is one origin list.
# CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# OTP delivery - email only, via Resend
# Get a key at https://resend.com/api-keys
# Production (DEBUG=False) refuses to boot without it unless
# REQUIRE_OTP_PROVIDERS=False, which makes /auth/otp/send/ return 503.
RESEND_API_KEY=
REQUIRE_OTP_PROVIDERS=True

# Contact form / concierge lead email
# Dev default is the console backend, which prints mail to the terminal.
# Production sets EMAIL_BACKEND to SMTP (Hostinger in render.yaml).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Primekey Homes <hello@primekeyhomesandpropertiesltd.com>
CONTACT_RECIPIENT_EMAIL=hello@primekeyhomesandpropertiesltd.com

# File storage
# Defaults to directories under backend/. Production points these at the
# Render disk mounted on primekey-api (/var/data), otherwise uploads are
# deleted on every deploy.
MEDIA_ROOT=
PROTECTED_STORAGE_DIR=
# Serve MEDIA_ROOT from Django when DEBUG=False. Set False behind a CDN/S3.
SERVE_MEDIA=True

# Behind a TLS-terminating proxy (Render): trust its X-Forwarded-Proto so
# SECURE_SSL_REDIRECT does not loop.
SECURE_SSL_REDIRECT=False

# Executive admin accounts (used by: python manage.py setup_roles)
# Leave unset to fall back to temporary ChangeMe-* passwords (change after first login).
ADMIN_PASSWORD=
CEO_PASSWORD=
CTO_PASSWORD=
COO_PASSWORD=