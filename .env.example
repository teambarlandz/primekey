# Primekey Homes - Docker Compose Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL
POSTGRES_DB=primekey
POSTGRES_USER=primekey
POSTGRES_PASSWORD=your_secure_password_here

# Django
SECRET_KEY=your_very_long_random_secret_key_here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Redis (internal docker network)
# These use the service names from docker-compose.yml
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
DJANGO_Q_REDIS_URL=redis://redis:6379/2

# CORS
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOW_CREDENTIALS=True

# SMS Provider (OTP delivery)
SMS_PROVIDER=termii
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=PrimeKey
TERMII_CHANNEL=dnd

# Sentry (error tracking)
SENTRY_DSN=

# S3 File Storage
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Frontend
NEXT_PUBLIC_API_URL=https://yourdomain.com/api